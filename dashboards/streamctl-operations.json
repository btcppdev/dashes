      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "probe_success{instance=\"https://stream.btcpp.dev/\"}", "refId": "A"}],
      "title": "Public site",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (stream, destination) (rate(streamctl_stream_destination_egress_bytes_estimate_total{service=\"streamctl\"}[$__rate_interval]))", "legendFormat": "{{stream}} → {{destination}}", "refId": "A"}],
      "title": "Estimated bandwidth by destination",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(node_network_transmit_bytes_total{job=\"node\",instance=\"streamctl\",device!~\"lo|veth.*\"}[$__rate_interval]))", "legendFormat": "host transmit", "refId": "A"},
        {"expr": "sum(rate(node_network_receive_bytes_total{job=\"node\",instance=\"streamctl\",device!~\"lo|veth.*\"}[$__rate_interval]))", "legendFormat": "host receive", "refId": "B"}
      ],
      "title": "Host network throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
      "id": 9,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 - avg(rate(node_cpu_seconds_total{job=\"node\",instance=\"streamctl\",mode=\"idle\"}[$__rate_interval])) * 100", "legendFormat": "CPU", "refId": "A"}],
      "title": "CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
      "id": 10,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "(1 - node_memory_MemAvailable_bytes{job=\"node\",instance=\"streamctl\"} / node_memory_MemTotal_bytes{job=\"node\",instance=\"streamctl\"}) * 100", "legendFormat": "memory", "refId": "A"}],
      "title": "Memory utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "id": 11,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "(1 - node_filesystem_avail_bytes{job=\"node\",instance=\"streamctl\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node\",instance=\"streamctl\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}) * 100", "legendFormat": "root disk", "refId": "A"}],
      "title": "Root disk utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "streamctl_gpu_jobs{service=\"streamctl\"}", "legendFormat": "{{state}}", "refId": "A"}],
      "title": "GPU queue by state",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "id": 13,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(streamctl_http_requests_total{service=\"streamctl\"}[$__rate_interval]))", "legendFormat": "all", "refId": "A"},
        {"expr": "sum(rate(streamctl_http_requests_total{service=\"streamctl\",code=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx", "refId": "B"}
      ],
      "title": "HTTP requests",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "id": 14,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(streamctl_http_request_duration_seconds_bucket{service=\"streamctl\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(streamctl_http_request_duration_seconds_bucket{service=\"streamctl\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(streamctl_http_request_duration_seconds_bucket{service=\"streamctl\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "HTTP latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "dateTimeAsIso"}, "overrides": []},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 28},
      "id": 15,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [{"expr": "streamctl_stream_next_trigger_timestamp_seconds{service=\"streamctl\"} * 1000", "format": "table", "instant": true, "refId": "A"}],
      "title": "Next scheduled streams",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "service": true, "stream_id": true}, "indexByName": {"stream": 0, "Value": 1}, "renameByName": {"Value": "Next trigger", "stream": "Stream"}}}],
      "type": "table"
    }
